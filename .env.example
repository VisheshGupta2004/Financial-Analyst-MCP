# Copy this file to `.env` and fill in real values as needed.
# `.env` is git-ignored -- never commit real API keys.

# --- LLM provider -----------------------------------------------------
# "mock"      -> deterministic, offline, no API key needed (default; used for
#                local dev, CI, and this repo's own tests/eval runner).
# "openai"    -> real OpenAI (or any OpenAI-compatible endpoint via LLM_BASE_URL).
# "anthropic" -> real Anthropic (Claude).
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30

# --- Critic / validator agent ------------------------------------------
CRITIC_ENABLED=true

# --- MCP -----------------------------------------------------------------
# How the orchestrator launches the MCP server as a subprocess.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m backend.mcp_server
MCP_TOOL_TIMEOUT_SECONDS=30

# --- Backend ---------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8501
REQUEST_TIMEOUT_SECONDS=45

# --- Data fetching (yfinance) ------------------------------------------
DATA_FETCH_MAX_RETRIES=3
DATA_FETCH_RETRY_BACKOFF_SECONDS=1.0
DATA_FETCH_TIMEOUT_SECONDS=20

# --- Cache -----------------------------------------------------------------
CACHE_ENABLED=true
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600

# --- Output ------------------------------------------------------------------
OUTPUT_DIR=output

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- Frontend (Streamlit) ----------------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
